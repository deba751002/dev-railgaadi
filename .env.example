# RailGaadi — Environment Variables Template
# Copy this file to ".env" (local dev) and fill in real values there.
# NEVER commit ".env" itself — only this ".env.example" template goes into git.
# Real values also get added to Cloudflare Pages → Settings → Environment Variables (as "Secret" type).

# --- RailRadar (live train position/status) ---
# Get from: RailRadar's developer/API signup page (check their site for current terms)
# If RailRadar has no usable free tier, swap in a RapidAPI Indian-railways API here instead.
RAILRADAR_API_KEY=

# --- MapTiler (map tiles) ---
# Get from: maptiler.com -> sign up -> Dashboard -> "API Keys" -> default key
MAPTILER_API_KEY=

# --- OpenWeather (weather at stations) ---
# Get from: openweathermap.org/api -> sign up -> "API keys" tab -> generate key
OPENWEATHER_API_KEY=

# --- OpenTopography (elevation profile) ---
# Get from: opentopography.org -> create "myOpenTopo" account -> account page -> request API key
OPENTOPOGRAPHY_API_KEY=

# --- Overpass API (POIs: rivers, mountains, bridges, monuments) ---
# No key needed — public endpoint. Leave this as the default public instance URL,
# or point to a different mirror later if the default gets rate-limited.
OVERPASS_API_URL=https://overpass-api.de/api/interpreter

# --- Cloudflare Workers KV (caching layer) ---
# Not an API key — this is a binding name, set up in Cloudflare dashboard
# (Workers & Pages -> KV -> Create namespace -> bind to project).
# No value needed here; referenced in code as context.env.RAILGAADI_CACHE
